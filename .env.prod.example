# Copy to ~/biotrack/.env.prod on the server
# ALL values are required — no defaults in production.

# ─── Base de Datos (Railway) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host.railway.app:5432/railway"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── JWT ──────────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="genera_con_crypto_randomBytes_48_minimo_64_hex_chars"
JWT_EXPIRES_IN="8h"

# ─── Cifrado AES-256-GCM ─────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="genera_con_crypto_randomBytes_32_exactamente_64_hex_chars"

# ─── Email Transaccional ──────────────────────────────────────────────────────
EMAIL_HOST="smtp.tu-proveedor.com"
EMAIL_PORT=587
EMAIL_USER="tu_usuario"
EMAIL_PASS="tu_contrasena"
EMAIL_FROM="noreply@biotrack.org.do"
EMAIL_FROM_NAME="BIOTRACK"

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="https://biotrack.org.do"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Dozzle (métricas / logs viewer en metrics.biotrack.org.do) ───────────────
DOZZLE_USERNAME="admin"
DOZZLE_PASSWORD="contrasena_segura"
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOZZLE_KEY="genera_con_crypto_randomBytes_32"
