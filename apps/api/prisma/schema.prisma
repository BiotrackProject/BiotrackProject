generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Accion_Correctiva {
  IDAccion            String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  responsable_id      String             @db.Uuid
  titulo              String             @db.VarChar(200)
  descripcion_accion  String?
  FechaPlanificacion  DateTime?          @db.Date
  FechaImplementacion DateTime?          @db.Date
  Estado              estado_accion      @default(Planificada)
  resumen_publico     String?            @db.VarChar(500)
  visibilidad         visibilidad_accion @default(Restringido)
  Resultado           String?
  Presupuesto         Decimal?           @db.Decimal(12, 2)
  created_at          DateTime           @default(now()) @db.Timestamp(6)
  updated_at          DateTime           @default(now()) @db.Timestamp(6)
  Usuario             Usuario            @relation(fields: [responsable_id], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
  Evidencia_Accion    Evidencia_Accion[]
  accion_denuncia     accion_denuncia[]
  accion_zona         accion_zona[]
}

model Denuncia {
  IDDenuncia                Int                         @id @default(autoincrement())
  codigo_seguimiento        String                      @unique @db.VarChar(8)
  IDUsuario                 String?                     @db.Uuid
  IDZona                    String?                     @db.Uuid
  Descripcion               String
  tipo_actividad            tipo_actividad_ilegal
  Fecha_denuncia            DateTime                    @default(now()) @db.Timestamp(6)
  hora_aproximada           DateTime?                   @db.Time(6)
  Estado                    estado_denuncia             @default(Pendiente)
  contacto_cifrado          String?
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @default(now()) @db.Timestamp(6)
  Usuario                   Usuario?                    @relation(fields: [IDUsuario], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
  Evidencia_Denuncia        Evidencia_Denuncia[]
  accion_denuncia           accion_denuncia[]
  historial_estado_denuncia historial_estado_denuncia[]

  @@index([codigo_seguimiento], map: "idx_denuncia_codigo")
  @@index([Estado], map: "idx_denuncia_estado")
  @@index([IDUsuario], map: "idx_denuncia_usuario")
  @@index([IDZona], map: "idx_denuncia_zona")
}

model Evidencia_Accion {
  IDEvidencia       String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  IDAccion          String            @db.Uuid
  archivo_url       String            @db.VarChar(500)
  TipoArchivo       tipo_archivo
  tamano_bytes      Int?
  hash_archivo      String?           @db.Char(64)
  fecha_carga       DateTime          @default(now()) @db.Timestamp(6)
  Accion_Correctiva Accion_Correctiva @relation(fields: [IDAccion], references: [IDAccion], onDelete: NoAction, onUpdate: NoAction)
}

model Evidencia_Denuncia {
  IDEvidencia  String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  IDDenuncia   Int
  archivo_url  String       @db.VarChar(500)
  TipoArchivo  tipo_archivo
  tamano_bytes Int?
  hash_archivo String?      @db.Char(64)
  fecha_carga  DateTime     @default(now()) @db.Timestamp(6)
  metadata     Json?        @db.Json
  Denuncia     Denuncia     @relation(fields: [IDDenuncia], references: [IDDenuncia], onDelete: NoAction, onUpdate: NoAction)
}

model Monitoreo {
  IDMonitoreo    String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  IDPunto        String           @db.Uuid
  IDUsuario      String           @db.Uuid
  Fecha_inicio   DateTime         @db.Timestamp(6)
  Fecha_fin      DateTime?        @db.Timestamp(6)
  Tipo_monitoreo tipo_monitoreo
  Estado         estado_monitoreo @default(En_Proceso)
  Usuario        Usuario          @relation(fields: [IDUsuario], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
}

model Municipios {
  IDMunicipio Int        @id @default(autoincrement())
  IDProvincia Int
  Nombre      String     @db.VarChar(100)
  Provincias  Provincias @relation(fields: [IDProvincia], references: [IDProvincia], onDelete: NoAction, onUpdate: NoAction)
}

model Provincias {
  IDProvincia Int          @id @default(autoincrement())
  Nombre      String       @db.VarChar(50)
  Region      String?      @db.VarChar(50)
  Municipios  Municipios[]
}

model Reporte {
  IDReporte      String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  generado_por   String         @db.Uuid
  TipoReporte    tipo_reporte
  periodo_inicio DateTime?      @db.Date
  periodo_fin    DateTime?      @db.Date
  filtros_usados Json?          @db.Json
  Estado         estado_reporte @default(Borrador)
  archivo_url    String?        @db.VarChar(500)
  created_at     DateTime       @default(now()) @db.Timestamp(6)
  Usuario        Usuario        @relation(fields: [generado_por], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
}

model Usuario {
  IDUsuario                 String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre_completo           String                      @db.VarChar(100)
  correo_electronico        String                      @unique @db.VarChar(100)
  contrasena_hash           String                      @db.VarChar(72)
  rol_id                    String                      @db.Uuid
  Estado                    estado_usuario              @default(Activo)
  cargo                     String?                     @db.VarChar(80)
  institucion               String?                     @db.VarChar(100)
  telefono                  String?                     @db.VarChar(20)
  Fecha_creacion            DateTime                    @default(now()) @db.Timestamp(6)
  Ultimo_acceso             DateTime?                   @db.Timestamp(6)
  Accion_Correctiva         Accion_Correctiva[]
  Denuncia                  Denuncia[]
  Monitoreo                 Monitoreo[]
  Reporte                   Reporte[]
  rol                       rol                         @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historial_estado_denuncia historial_estado_denuncia[]
  historial_riesgo_zona     historial_riesgo_zona[]
  solicitud_registro        solicitud_registro[]
}

model accion_denuncia {
  IDAccion          String            @db.Uuid
  IDDenuncia        Int
  Accion_Correctiva Accion_Correctiva @relation(fields: [IDAccion], references: [IDAccion], onDelete: Cascade, onUpdate: NoAction)
  Denuncia          Denuncia          @relation(fields: [IDDenuncia], references: [IDDenuncia], onDelete: Cascade, onUpdate: NoAction)

  @@id([IDAccion, IDDenuncia])
}

model accion_zona {
  IDAccion          String            @db.Uuid
  IDZona            String            @db.Uuid
  Accion_Correctiva Accion_Correctiva @relation(fields: [IDAccion], references: [IDAccion], onDelete: Cascade, onUpdate: NoAction)

  @@id([IDAccion, IDZona])
}

model historial_estado_denuncia {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  IDDenuncia      Int
  IDUsuario       String          @db.Uuid
  estado_anterior estado_denuncia
  estado_nuevo    estado_denuncia
  comentario      String?         @db.VarChar(500)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  Denuncia        Denuncia        @relation(fields: [IDDenuncia], references: [IDDenuncia], onDelete: NoAction, onUpdate: NoAction)
  Usuario         Usuario         @relation(fields: [IDUsuario], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
}

model historial_riesgo_zona {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  IDZona         String       @db.Uuid
  IDUsuario      String       @db.Uuid
  nivel_anterior nivel_riesgo
  nivel_nuevo    nivel_riesgo
  justificacion  String?
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  Usuario        Usuario      @relation(fields: [IDUsuario], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
}

model log_auditoria {
  id         String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  accion     String              @db.VarChar(100)
  modulo     String              @db.VarChar(50)
  ip_address String?             @db.VarChar(45)
  resultado  resultado_auditoria
  detalle    Json?               @db.Json
  created_at DateTime            @default(now()) @db.Timestamp(6)

  @@index([created_at(sort: Desc)], map: "idx_log_auditoria_created_at")
  @@index([modulo], map: "idx_log_auditoria_modulo")
}

model permiso {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  modulo      String         @db.VarChar(50)
  accion      accion_permiso
  rol_permiso rol_permiso[]

  @@unique([modulo, accion])
}

model rol {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre      String        @unique @db.VarChar(50)
  descripcion String?
  created_at  DateTime      @default(now()) @db.Timestamp(6)
  Usuario     Usuario[]
  rol_permiso rol_permiso[]
}

model rol_permiso {
  rol_id     String  @db.Uuid
  permiso_id String  @db.Uuid
  permiso    permiso @relation(fields: [permiso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rol        rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([rol_id, permiso_id])
}

model solicitud_registro {
  id                 String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre_completo    String           @db.VarChar(100)
  correo_electronico String           @db.VarChar(100)
  cargo              String?          @db.VarChar(80)
  institucion        String?          @db.VarChar(100)
  estado             estado_solicitud @default(Pendiente_Aprobacion)
  revisado_por       String?          @db.Uuid
  comentario_admin   String?          @db.VarChar(300)
  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @default(now()) @db.Timestamp(6)
  Usuario            Usuario?         @relation(fields: [revisado_por], references: [IDUsuario], onDelete: NoAction, onUpdate: NoAction)
}

model Zona_Critica {
  IDZona               String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  IDMunicipio          BigInt
  responsable_tecnico  String?                   @db.Uuid
  NombreZona           String[]                  @db.VarChar(150)
  Geometria            Unsupported("_polygon")[]
  NivelDeRiesgo        nivel_riesgo              @default(Bajo)
  categoria_ecosistema categoria_ecosistema[]
  Estado               estado_zona               @default(Activa)
  area_m2              Int?
  api_key_hash         String[]                  @db.VarChar(64)
  fecha_identificacion DateTime?                 @db.Date
  descripcion          String?
  created_at           DateTime                  @default(now()) @db.Timestamp(6)
  updated_at           DateTime                  @default(now()) @db.Timestamp(6)
}

enum accion_permiso {
  Leer
  Crear
  Editar
  Eliminar_Logico
  Exportar
  Publicar
  Configurar
}

enum categoria_ecosistema {
  Rio
  Playa
  Zona_Costera
  Area_Protegida
  Otro
}

enum estado_accion {
  Planificada
  En_Ejecucion
  Completada
  Cancelada
}

enum estado_denuncia {
  Pendiente
  En_Investigacion
  Verificada
  Resuelta
  Desestimada
}

enum estado_monitoreo {
  En_Proceso
  Completado
  Cancelado
}

enum estado_punto {
  Activo
  Inactivo
  Mantenimiento
}

enum estado_reporte {
  Borrador
  Publicado
  Archivado
}

enum estado_solicitud {
  Pendiente_Aprobacion
  Aprobada
  Rechazada
  Pendiente_Info
}

enum estado_usuario {
  Activo
  Inactivo
}

enum estado_zona {
  Activa
  Inactiva
}

enum nivel_riesgo {
  Bajo
  Medio
  Alto
  Critico
}

enum resultado_auditoria {
  Exito
  Fallo
}

enum tipo_actividad_ilegal {
  Extraccion_Rio
  Extraccion_Playa
  Extraccion_Zona_Protegida
  Transporte_Ilegal
  Otro
}

enum tipo_archivo {
  Imagen
  Documento
  Video
  Audio
}

enum tipo_monitoreo {
  Automatico
  Manual
  Mixto
}

enum tipo_reporte {
  Denuncias
  Monitoreos
  Acciones
  Consolidado
}

enum tipo_sensor {
  Turbidez
  Temperatura
  Movimiento
  Nivel_Agua
  Audio
  GPS_Tracker
  Otro
}

enum visibilidad_accion {
  Publico
  Restringido
}
