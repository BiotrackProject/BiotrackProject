# Caddyfile — BIOTRACK Production Reverse Proxy
# Caddy obtains and renews TLS certificates automatically (Let's Encrypt).
#
# TLS strategy: TLS-ALPN-01 challenge only (port 443).
# Port 80 is intentionally NOT exposed in docker-compose.prod.yml — all traffic
# is HTTPS-only. No redirect listener is created.

{
    # Disable the automatic HTTP→HTTPS redirect so Caddy does not bind port 80.
    # Certificates are renewed via TLS-ALPN-01 (port 443 only).
    auto_https disable_redirects

    # Centralised admin API — disable or restrict in production
    admin off
}

# ── Frontend ────────────────────────────────────────────────────────────────────
biotrack.org.do {

    reverse_proxy frontend:80 {
        header_up X-Real-IP       {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }

    header {
        # ── Transport Security ────────────────────────────────────────────────
        # 1 year, all subdomains, eligible for browser preload list.
        # IMPORTANT: preload is a long-term commitment — the domain and all
        # subdomains must stay HTTPS-only permanently once submitted.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # ── Framing & type sniffing ───────────────────────────────────────────
        X-Frame-Options         "DENY"
        X-Content-Type-Options  "nosniff"

        # ── Referrer ──────────────────────────────────────────────────────────
        # Sends origin on same-site requests; nothing on cross-site.
        Referrer-Policy "strict-origin-when-cross-origin"

        # ── Cross-Origin isolation ────────────────────────────────────────────
        # Isolates the window from cross-origin openers (prevents tab-napping).
        Cross-Origin-Opener-Policy "same-origin"

        # credentialless: strips credentials from cross-origin subresource
        # requests instead of blocking them outright, so third parties that
        # don't send Cross-Origin-Resource-Policy (Google Fonts, OSM tiles,
        # Unsplash) keep loading. Re-evaluate if any of those start requiring
        # credentialed requests.
        Cross-Origin-Embedder-Policy "credentialless"

        # This origin's own assets (JS/CSS/favicon) are not shared cross-origin.
        Cross-Origin-Resource-Policy "same-origin"

        # ── Permissions Policy ────────────────────────────────────────────────
        # Disable features the app does not need. geolocation=(self) is
        # kept in case the report form adds browser-based location in the future.
        Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), geolocation=(self \"https://biotrack.org.do\")"

        # ── Content Security Policy ───────────────────────────────────────────
        # script-src: Vite bundles as same-origin ES modules — no eval/inline.
        # style-src:  'unsafe-inline' required for Leaflet/intro.js runtime CSS
        #             injection; googleapis needed for Google Fonts stylesheet.
        # img-src:    data: for Leaflet markers; OSM tiles served from
        #             *.tile.openstreetmap.org; Unsplash for landing page imagery.
        # font-src:   gstatic.com serves the actual font files for Google Fonts.
        # connect-src: API on api.biotrack.org.do; OSM nominatim for geocoding.
        # frame-ancestors: explicit 'none' backs up X-Frame-Options DENY above.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://images.unsplash.com https://*.tile.openstreetmap.org; connect-src 'self' https://api.biotrack.org.do https://nominatim.openstreetmap.org; font-src 'self' https://fonts.gstatic.com; frame-src https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

        # ── Remove server fingerprinting ──────────────────────────────────────
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size     50mb
            roll_keep     5
            roll_keep_for 720h
        }
    }
}

# ── Metrics (Dozzle) ────────────────────────────────────────────────────────────
# Dozzle handles its own auth (DOZZLE_USERNAME / DOZZLE_PASSWORD / DOZZLE_KEY).
# Caddy adds TLS termination and security headers on top.
metrics.biotrack.org.do {

    reverse_proxy dozzle:8080 {
        header_up X-Real-IP       {remote_host}
        header_up X-Forwarded-Proto https
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "no-referrer"
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://metrics.biotrack.org.do; font-src 'self'"
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/metrics-access.log {
            roll_size     20mb
            roll_keep     3
            roll_keep_for 720h
        }
    }
}

# ── API ─────────────────────────────────────────────────────────────────────────
api.biotrack.org.do {

    reverse_proxy api:3000 {
        header_up X-Real-IP       {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }

    header {
        # ── Transport Security ────────────────────────────────────────────────
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # ── Sniffing & framing ────────────────────────────────────────────────
        X-Content-Type-Options "nosniff"
        X-Frame-Options        "DENY"

        # ── Referrer ──────────────────────────────────────────────────────────
        # API responses never need to leak origin info to third parties.
        Referrer-Policy "no-referrer"

        # ── Cross-Origin isolation ────────────────────────────────────────────
        Cross-Origin-Opener-Policy "same-origin"

        # ── CSP — strict for a pure JSON API ─────────────────────────────────
        # This origin serves no HTML, fonts, images, or scripts.
        # frame-ancestors 'none' blocks embedding the API in any frame.
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

        # ── Permissions Policy ────────────────────────────────────────────────
        Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=()"

        # ── Remove server fingerprinting ──────────────────────────────────────
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/api-access.log {
            roll_size     50mb
            roll_keep     5
            roll_keep_for 720h
        }
    }
}
